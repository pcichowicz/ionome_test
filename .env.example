# --- Environment ---
ENV=development

# --- Pipeline identity ---
PIPELINE_NAME=ionome-lcms

# --- Storage backend ---
STORAGE_BACKEND=local

# Local storage paths (used when STORAGE_BACKEND=local)
LCMS_RAW_DATA_DIR=""
LCMS_RESULTS_DIR=""
LCMS_REFERENCE_LIBRARY_DIR=""
YAML_DIR=""
OUTPUT_DIRS=["features","logs","plots","library","qc_reports","cache"]

# S3 (only used when STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Database ---
LCMS_DB_NAME=ionome
LCMS_DB_PATH=""
LCMS_DB_ECHO=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_INFO=info

# --- Pipeline ---
LCMS_MAX_WORKERS=4
LCMS_CACHE_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
